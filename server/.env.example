PORT=5000
NODE_ENV=development
# Required: use a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MONGO_URI=mongodb://127.0.0.1:27017/resume_builder
# Comma-separated frontend origins. Empty allows all origins (useful for local development only).
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
# Optional Gemini-compatible OpenAI SDK configuration.
GEMINI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gemini-2.5-flash
# Optional ImageKit configuration.
IMAGEKIT_PRIVATE_KEY=
