
PORT=5000
NODE_ENV=development

# Generate a unique random secret with at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017/resume_builder

# Comma-separated frontend origins. Required in production.
CLIENT_URL=http://localhost:5173

# File upload configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional AI provider configuration

# Optional production password-reset email using Resend.
# Set these in the deployment environment; never commit real values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Production defaults to SameSite=Lax. Set to "none" only for a cross-site frontend/API setup.
COOKIE_SAME_SITE=lax
# Optional AI enhancement (Gemini OpenAI-compatible endpoint)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.5-flash

# Optional ImageKit uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
